{
  "name": "vigilmap",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source global intelligence platform \u2014 unified real-time monitoring of health, climate, conflict, disasters, economics, labor, and science.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.api.json && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.api.json",
    "backfill:cyber": "tsx --env-file=.env.local scripts/backfill-cyber.ts",
    "test": "vitest run",
    "dev:api": "tsx --env-file=.env.local scripts/dev-api.ts"
  },
  "dependencies": {
    "@deck.gl/core": "^9.2.9",
    "@deck.gl/layers": "^9.2.9",
    "@deck.gl/mapbox": "^9.2.9",
    "@upstash/redis": "^1.41.0",
    "maplibre-gl": "^5.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^5.1.1"
  }
}
