# ── AI Intelligence Briefs (NVIDIA NIM) ───────────────────
# Server-side only: read by api/brief.ts, NEVER prefix with VITE_ (it would ship to browsers).
# Free key at: https://build.nvidia.com  — set it in Vercel project env vars too.
NVIDIA_API_KEY=nvapi-your-key-here

# ── NASA FIRMS — Satellite Wildfire Detection ─────────────
# Free API key for VIIRS/MODIS active fire data
# Register at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Without this key, DEMO_KEY is used (low rate limit, may be throttled)
VITE_NASA_FIRMS_API_KEY=your-nasa-key-here

# ── Map Tiles (optional) ──────────────────────────────────
# MapTiler — free for open source projects
# https://cloud.maptiler.com/account/keys/
# Without this key, the map falls back to OSM raster tiles
# VITE_MAPTILER_API_KEY=your-maptiler-key-here

# ── Cyber history (Upstash Redis via Vercel Marketplace) ──
# Add the "Upstash Redis" integration to the Vercel project (Storage tab); it injects these.
# For local backfill: `vercel env pull .env.local` or paste them here.
# KV_REST_API_URL=https://your-db.upstash.io
# KV_REST_API_TOKEN=your-token
# Vercel Cron authenticates to /api/cron/cyber-sync with this (any long random string):
# CRON_SECRET=generate-a-long-random-string
