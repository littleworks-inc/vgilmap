# ── AI Intelligence Briefs (NVIDIA NIM) ───────────────────
# Server-side only: read by api/brief.ts, NEVER prefix with VITE_ (it would ship to browsers).
# Free key at: https://build.nvidia.com  — set it in Vercel project env vars too.
NVIDIA_API_KEY=nvapi-your-key-here

# ── NASA FIRMS — Satellite Wildfire Detection ─────────────
# Free API key for VIIRS active fire data. Server-side only (api/firms.ts) — no VITE_ prefix needed.
# (The legacy name VITE_NASA_FIRMS_API_KEY is still read by the server, but it is NOT exposed to the browser.)
# Register at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Without this key, DEMO_KEY is used (low rate limit, may be throttled)
NASA_FIRMS_API_KEY=your-nasa-key-here
