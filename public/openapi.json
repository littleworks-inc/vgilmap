{
  "openapi": "3.0.3",
  "info": {
    "title": "VigilMap API",
    "description": "Real-time global intelligence events API. Aggregates USGS earthquakes, NASA wildfires, NOAA weather alerts, GDELT conflict news, WHO disease outbreaks, ReliefWeb humanitarian crises, and GDELT economic/labor events into a unified schema.",
    "version": "1.0.0",
    "contact": { "email": "contact@vigilmap.app" },
    "license": { "name": "MIT" }
  },
  "servers": [{ "url": "https://vgilmap.vercel.app" }],
  "paths": {
    "/api/v1/events": {
      "get": {
        "summary": "List current global events",
        "description": "Returns normalized global intelligence events from the shared pipeline (13 sources). Totals and summary cover everything matching the filters, before pagination. Cached per source refresh interval.",
        "parameters": [
          { "name": "domain", "in": "query", "description": "Comma-separated domains to include", "schema": { "type": "string", "example": "disaster,conflict" } },
          { "name": "severity", "in": "query", "description": "Minimum severity level", "schema": { "type": "string", "enum": ["info","low","medium","high","critical"] } },
          { "name": "limit", "in": "query", "description": "Page size, 1 to 1000 (out-of-range values are rejected with 400). Use next_cursor in the response to continue.", "schema": { "type": "integer", "default": 100, "maximum": 1000 } },
          { "name": "cursor", "in": "query", "description": "Pass next_cursor from the previous response to get the next page. Stable while events arrive or expire.", "schema": { "type": "string" } },
          { "name": "source", "in": "query", "description": "Comma-separated source keys. Default: every source except the optional GDELT extra", "schema": { "type": "string", "example": "usgs-day,noaa" } },
          { "name": "optional", "in": "query", "description": "Set to 1 to include optional sources in a whole-dataset request", "schema": { "type": "string", "enum": ["1"] } },
          { "name": "location", "in": "query", "description": "map = events with a place on the map; nomap = list-only events", "schema": { "type": "string", "enum": ["map","nomap"] } },
          { "name": "since", "in": "query", "description": "ISO timestamp — only events after this time", "schema": { "type": "string", "format": "date-time" } }
        ],
        "responses": {
          "400": { "description": "Unsupported or empty filter, impossible date, out-of-range limit, malformed cursor. Body: { ok: false, error, valid? } with the accepted values" },
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "count": { "type": "integer" },
                    "total": { "type": "integer" },
                    "generated": { "type": "string", "format": "date-time" },
                    "version": { "type": "string" },
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/VigilEvent" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/summary": {
      "get": {
        "summary": "Event counts by domain and severity",
        "responses": {
          "200": {
            "description": "Summary statistics",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "total_events": { "type": "integer" },
                    "by_domain": { "type": "object" },
                    "by_severity": { "type": "object" },
                    "top_events": { "type": "array" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VigilEvent": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" },
          "domain": { "type": "string", "enum": ["disaster","climate","health","conflict","economic","labor","science","cyber"] },
          "category": { "type": "string" },
          "severity": { "type": "string", "enum": ["info","low","medium","high","critical"] },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "location": {
            "type": "object",
            "properties": {
              "lat": { "type": "number" },
              "lng": { "type": "number" },
              "country": { "type": "string" },
              "region": { "type": "string" },
              "label": { "type": "string" }
            }
          },
          "source": { "type": "string" },
          "sourceUrl": { "type": "string" },
          "confidence": { "type": "number" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
